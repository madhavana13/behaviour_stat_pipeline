# -------------------------
# Python artifacts
# -------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
.venv/

# -------------------------
# IDE
# -------------------------
.vscode/

# -------------------------
# Data (do NOT track large/generated data)
# -------------------------
data/raw/
data/interim/
data/processed/

# BUT keep metadata + configs
!data/metadata/*.csv
!configs/*.csv

# -------------------------
# Outputs (always generated)
# -------------------------
outputs/

# -------------------------
# Logs
# -------------------------
*.log

# -------------------------
# Figures (generated)
# -------------------------
*.png
*.pdf
*.svg

# -------------------------
# Tables (generated ONLY in outputs/)
# -------------------------
outputs/**/*.csv